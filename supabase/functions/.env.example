# Secrets for Edge Functions. Locally: supabase functions serve --env-file supabase/functions/.env
# In production: supabase secrets set RESEND_API_KEY=... INVITE_FROM_EMAIL=...
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Optional — enables invitation emails (https://resend.com). Without it the app shares links instead.
RESEND_API_KEY=
INVITE_FROM_EMAIL="Family Finance <invites@yourdomain.com>"

# Optional — https base URL that opens invitation links (universal/app links). Defaults to familyfinance://
INVITE_BASE_URL=

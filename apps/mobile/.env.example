# Copy to apps/mobile/.env.local and fill in from your Supabase project
# (Project Settings → API). Only the anon (publishable) key belongs in the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: https URL that should open invitation links (falls back to the
# familyfinance:// deep link scheme).
EXPO_PUBLIC_INVITE_BASE_URL=

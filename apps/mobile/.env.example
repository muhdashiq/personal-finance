# Copy to apps/mobile/.env.local, fill in, then restart Expo with `npx expo start -c`.
#
# From the Supabase dashboard:
#   URL → Project Settings → Data API (or the "Connect" button)   e.g. https://abcdefghijkl.supabase.co
#   Key → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
#         or, on the Legacy API Keys tab, the "anon" key.
# Never use the secret / service_role key in the app.
#
# For a local `supabase start` stack on a phone, use your computer's LAN IP
# (e.g. http://192.168.1.20:54321) — 127.0.0.1 would point at the phone itself.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Optional: https URL that should open invitation links (falls back to the
# familyfinance:// deep link scheme).
EXPO_PUBLIC_INVITE_BASE_URL=
